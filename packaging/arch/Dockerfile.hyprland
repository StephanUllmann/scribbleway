# Nested-Hyprland test harness.
#
# Runs the built Arch package inside a real Hyprland session that itself nests
# inside the host's Wayland compositor (Hyprland's wayland backend). Waybar
# supplies the StatusNotifierHost that Hyprland does not provide on its own —
# the exact dependency Phase 2 exists to validate.
#
# Driven by run_hyprland_test.sh; not part of the release package build.
FROM archlinux:latest

RUN pacman -Sy --noconfirm archlinux-keyring && \
    pacman -Syu --noconfirm && \
    pacman -S --noconfirm \
        hyprland waybar dbus grim wtype \
        layer-shell-qt kglobalaccel qt6-declarative qt6-base qt6-wayland \
        ttf-dejavu

# Must match the host user: the mounted Wayland socket and the /out bind mount
# are both owned by them.
ARG UID=1000
ARG GID=1000
RUN groupadd -g "$GID" user && useradd -u "$UID" -g "$GID" -m user && \
    mkdir -p /out && chown "$UID:$GID" /out

# Lua, not hyprland.conf: Hyprland switched config languages in 0.55 and plans to
# drop hyprlang a release or two later. hl.monitor sizes the nested output window.
# QT_QPA_PLATFORM=wayland is required or LayerShellQt never attaches.
RUN mkdir -p /home/user/.config/hypr && cat > /home/user/.config/hypr/hyprland.lua <<'EOF'
hl.monitor({
    output   = "",
    mode     = "1600x900@60",
    position = "0x0",
    scale    = 1,
})

hl.env("QT_QPA_PLATFORM", "wayland")

hl.config({
    misc = {
        disable_hyprland_logo    = true,
        disable_splash_rendering = true,
        force_default_wallpaper  = 0,
    },
})

-- Verbatim the line the README tells Hyprland users to add. KGlobalAccel is inert
-- without kglobalacceld, so this is the only way into the overlay here.
hl.bind("SUPER + SHIFT + X", hl.dsp.exec_cmd("scribbleway-overlay --toggle"))

hl.on("hyprland.start", function()
    hl.exec_cmd("sh -c 'exec waybar > /out/waybar.log 2>&1'")
    -- Delayed so Waybar's StatusNotifierHost has registered first. Starting it
    -- immediately is the interesting race; a clean baseline comes first.
    hl.exec_cmd("sh -c 'sleep 3; exec scribbleway-overlay > /out/scribbleway.log 2>&1'")
    hl.exec_cmd("/usr/local/bin/check.sh")
end)
EOF

# Collects everything in Task 4 that is checkable without a pointer device.
RUN cat > /usr/local/bin/check.sh <<'EOF'
#!/bin/bash
set -u
sleep 8

exec > /out/report.txt 2>&1

echo "=== processes ==="
pgrep -a -f 'scribbleway-overlay|waybar' || echo "NONE RUNNING"

echo
echo "=== StatusNotifier on the session bus ==="
busctl --user list --no-pager 2>&1 | grep -i statusnotifier || echo "NONE"

echo
echo "=== layer-shell surfaces (overlay + tray popup live here) ==="
hyprctl layers

echo
echo "=== overlay covers the whole output? ==="
# An annotation overlay must not be pushed out of a bar's exclusive zone.
# Output size comes from the monitor= line in hyprland.conf.
GEOM=$(hyprctl layers | grep 'namespace: scribbleway-overlay' \
       | grep -o 'xywh: [0-9]* [0-9]* [0-9]* [0-9]*' | cut -d' ' -f2-)
if [ "$GEOM" = "0 0 1600 900" ]; then
    echo "PASS full-output coverage ($GEOM)"
else
    echo "FAIL want '0 0 1600 900', got '$GEOM' — bar exclusive zone is shrinking the overlay"
fi

echo
echo "=== keyboard: Super+Shift+X must enter a mode, local hotkeys must reach QML ==="
# There is no compositor-side query for "who holds keyboard focus", so assert on
# what the user would see instead: a mode change has to repaint. Crop away the
# waybar clock, which ticks on its own and would differ every capture.
shot() { grim -g "0,100 1200x700" "/out/$1.png" 2>/dev/null && md5sum "/out/$1.png" | cut -c1-8; }

# Entering select mode paints nothing on an empty canvas, so the toggle isn't
# directly observable. Probe it with the ellipse tool instead, which draws a cursor
# badge — and press it once beforehand as a negative control.
BASE=$(shot 1-passthrough)

# Negative control: passthrough must not hold the keyboard at all.
wtype e 2>&1 || echo "wtype failed"
sleep 2
LEAKED=$(shot 2-passthrough-after-e)
[ "$LEAKED" = "$BASE" ] \
    && echo "PASS passthrough ignores 'e' ($BASE)" \
    || echo "FAIL passthrough reacted to 'e' ($BASE -> $LEAKED) — overlay is eating keys it should pass through"

# Drive the compositor keybind rather than calling --toggle directly: that exercises
# the whole documented path, Hyprland bind -> exec -> single-instance socket -> daemon.
wtype -M logo -M shift -k x -m shift -m logo 2>&1 || echo "wtype failed"
sleep 3
wtype e 2>&1 || echo "wtype failed"
sleep 2
ACTIVE=$(shot 3-ellipse-tool)
[ "$ACTIVE" != "$BASE" ] \
    && echo "PASS Super+Shift+X entered a mode and 'e' reached QML ($BASE -> $ACTIVE)" \
    || echo "FAIL still inert ($BASE) — the bind never reached the daemon, or no keyboard focus"

wtype -k Escape 2>&1 || true
sleep 1
if pgrep -f scribbleway-overlay >/dev/null; then
    echo "SURVIVED the keyboard probe"
else
    echo "DIED during the keyboard probe"
fi

echo
echo "=== scribbleway stderr ==="
cat /out/scribbleway.log 2>/dev/null || echo "(no log)"

grim /out/screen.png 2>&1 || echo "grim failed"

# Lua config changed dispatcher syntax: plain `dispatch exit` errors out, which used
# to leave the container running forever.
[ -n "${KEEP_OPEN:-}" ] || hyprctl dispatch 'hl.dsp.exit()'
EOF
RUN chmod +x /usr/local/bin/check.sh && chown -R "$UID:$GID" /home/user

ARG PKG
COPY ${PKG} /tmp/scribbleway.pkg.tar.zst
RUN pacman -U --noconfirm /tmp/scribbleway.pkg.tar.zst

USER user
ENV XDG_RUNTIME_DIR=/tmp/xdg
CMD ["sh", "-c", "mkdir -p $XDG_RUNTIME_DIR && chmod 700 $XDG_RUNTIME_DIR && exec dbus-run-session -- Hyprland"]
